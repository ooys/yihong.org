---
import { getCollection, type CollectionEntry } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';

type BlogPost = CollectionEntry<'blog'>;

// Generate a page for each blog post
export async function getStaticPaths() {
  const blogEntries = await getCollection('blog', (entry: BlogPost) => {
    // Private posts are only accessible in dev mode
    if (entry.data.visibility === 'private') {
      return !import.meta.env.PROD;
    }
    // Public and unlisted posts are always generated
    return true;
  });

  return blogEntries.map((entry: BlogPost) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

type Props = {
  entry: BlogPost;
};

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<BlogLayout
  title={entry.data.title}
  description={entry.data.description}
  pubDate={entry.data.pubDate}
  author={entry.data.author}
  visibility={entry.data.visibility}
>
  <Content />
</BlogLayout>

